generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model logs {
  id          Int      @id @default(autoincrement())
  user_id     Int
  action      String   @db.VarChar(100)
  description String
  created_at  DateTime @default(now()) @db.Timestamp(6)
  usuario     usuario  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_logs_user")
}

model usuario {
  id                    Int        @id @default(autoincrement())
  name                  String     @db.VarChar(100)
  email                 String     @unique @db.VarChar(100)
  senha                 String     @db.VarChar(255)
  role                  user_role
  ativo                 Boolean    @default(true)
  invitation_token_hash String?    @unique @db.VarChar(64)
  invitation_expires_at DateTime?  @db.Timestamptz(6)
  conteudo              conteudo[]
  quizzes               quiz[]
  logs                  logs[]
  attempts              attempt[]
}

model conteudo {
  id           Int     @id @default(autoincrement())
  professor_id Int
  title        String  @db.VarChar(150)
  description  String
  usuario      usuario @relation(fields: [professor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quiz         quiz?
}

model quiz {
  id           Int        @id @default(autoincrement())
  conteudo_id  Int        @unique
  professor_id Int
  conteudo     conteudo   @relation(fields: [conteudo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario      usuario    @relation(fields: [professor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions    question[]
  attempts     attempt[]
}

model question {
  id           Int           @id @default(autoincrement())
  quiz_id      Int
  statement    String
  quiz         quiz          @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alternatives alternative[]
  answers      answer[]

  @@index([quiz_id])
  @@map("questao")
}

model alternative {
  id          Int      @id @default(autoincrement())
  question_id Int
  text        String
  correct     Boolean  @default(false)
  question    question @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  answers     answer[]

  @@index([question_id])
  @@map("alternativa")
}

model attempt {
  id         Int      @id @default(autoincrement())
  quiz_id    Int
  student_id Int
  score      Decimal  @db.Decimal(4, 1)
  approved   Boolean
  created_at DateTime @default(now()) @db.Timestamp(6)
  quiz       quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student    usuario  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers    answer[]

  @@index([quiz_id])
  @@index([student_id])
  @@map("tentativa")
}

model answer {
  id             Int         @id @default(autoincrement())
  attempt_id     Int
  question_id    Int
  alternative_id Int
  attempt        attempt     @relation(fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question       question    @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alternative    alternative @relation(fields: [alternative_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([attempt_id, question_id])
  @@index([question_id])
  @@index([alternative_id])
  @@map("resposta")
}

enum user_role {
  Admin
  Aluno_a_     @map("Aluno(a)")
  Professor_a_ @map("Professor(a)")
}
