generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model logs {
  id          Int      @id @default(autoincrement())
  user_id     Int
  action      String   @db.VarChar(100)
  description String
  created_at  DateTime @default(now()) @db.Timestamp(6)
  usuario     usuario  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_logs_user")
}

model usuario {
  id    Int       @id @default(autoincrement())
  name  String    @db.VarChar(100)
  email String    @unique @db.VarChar(100)
  senha String    @db.VarChar(255)
  role  user_role
  ativo Boolean   @default(true)
  logs  logs[]
}

enum user_role {
  Admin
  Aluno_a_     @map("Aluno(a)")
  Professor_a_ @map("Professor(a)")
}
