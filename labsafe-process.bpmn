<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Student" name="Aluno" processRef="Process_Student"/>
    <bpmn:participant id="Participant_System" name="Sistema LabSafe" processRef="Process_System"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Student" isExecutable="false">
    <bpmn:startEvent id="Event_StudentStart" name="Aluno acessa o sistema">
      <bpmn:outgoing>Flow_StudentLogin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_StudentLogin" name="Fazer login">
      <bpmn:incoming>Flow_StudentLogin</bpmn:incoming>
      <bpmn:outgoing>Flow_StudentLoginDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StudentTakeTraining" name="Realizar treinamento">
      <bpmn:incoming>Flow_StudentLoginDone</bpmn:incoming>
      <bpmn:incoming>Flow_RetrainingLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_StudentTrainingDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StudentDoQuiz" name="Resolver questionário">
      <bpmn:incoming>Flow_StudentTrainingDone</bpmn:incoming>
      <bpmn:outgoing>Flow_StudentQuizDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_StudentPass" name="Passou no teste?">
      <bpmn:incoming>Flow_StudentQuizDone</bpmn:incoming>
      <bpmn:outgoing>Flow_StudentPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_StudentFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_StudentPassEnd" name="Certificado concedido">
      <bpmn:incoming>Flow_StudentPassed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_StudentRetrain" name="Refazer treinamento">
      <bpmn:incoming>Flow_StudentFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_RetrainingLoop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_StudentLogin" sourceRef="Event_StudentStart" targetRef="Task_StudentLogin"/>
    <bpmn:sequenceFlow id="Flow_StudentLoginDone" sourceRef="Task_StudentLogin" targetRef="Task_StudentTakeTraining"/>
    <bpmn:sequenceFlow id="Flow_StudentTrainingDone" sourceRef="Task_StudentTakeTraining" targetRef="Task_StudentDoQuiz"/>
    <bpmn:sequenceFlow id="Flow_StudentQuizDone" sourceRef="Task_StudentDoQuiz" targetRef="Gateway_StudentPass"/>
    <bpmn:sequenceFlow id="Flow_StudentPassed" name="Sim (≥60%)" sourceRef="Gateway_StudentPass" targetRef="Event_StudentPassEnd"/>
    <bpmn:sequenceFlow id="Flow_StudentFailed" name="Não (&lt;60%)" sourceRef="Gateway_StudentPass" targetRef="Task_StudentRetrain"/>
    <bpmn:sequenceFlow id="Flow_RetrainingLoop" sourceRef="Task_StudentRetrain" targetRef="Task_StudentTakeTraining"/>
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:startEvent id="Event_SystemStart" name="Sistema inicia">
      <bpmn:outgoing>Flow_SystemInit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SystemListen" name="Servidor aguardando requisições (porta)">
      <bpmn:incoming>Flow_SystemInit</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestReceived</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RequestType" name="Tipo de requisição?">
      <bpmn:incoming>Flow_RequestReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_AuthRequest</bpmn:outgoing>
      <bpmn:outgoing>Flow_UserRequest</bpmn:outgoing>
      <bpmn:outgoing>Flow_PubChemRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AuthHandler" name="Processar autenticação (JWT)">
      <bpmn:incoming>Flow_AuthRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_AuthProcessed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_UserHandler" name="Processar usuário (CRUD)">
      <bpmn:incoming>Flow_UserRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_UserProcessed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PubChemHandler" name="Buscar dados PubChem (química)">
      <bpmn:incoming>Flow_PubChemRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_PubChemProcessed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DatabaseQuery" name="Consultar/Atualizar BD (PostgreSQL)">
      <bpmn:incoming>Flow_AuthProcessed</bpmn:incoming>
      <bpmn:incoming>Flow_UserProcessed</bpmn:incoming>
      <bpmn:outgoing>Flow_DatabaseDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendResponse" name="Enviar resposta (CORS habilitado)">
      <bpmn:incoming>Flow_DatabaseDone</bpmn:incoming>
      <bpmn:incoming>Flow_PubChemProcessed</bpmn:incoming>
      <bpmn:outgoing>Flow_ResponseSent</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_SystemEnd" name="Resposta entregue">
      <bpmn:incoming>Flow_ResponseSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SystemInit" sourceRef="Event_SystemStart" targetRef="Task_SystemListen"/>
    <bpmn:sequenceFlow id="Flow_RequestReceived" sourceRef="Task_SystemListen" targetRef="Gateway_RequestType"/>
    <bpmn:sequenceFlow id="Flow_AuthRequest" name="/auth" sourceRef="Gateway_RequestType" targetRef="Task_AuthHandler"/>
    <bpmn:sequenceFlow id="Flow_UserRequest" name="/api/users" sourceRef="Gateway_RequestType" targetRef="Task_UserHandler"/>
    <bpmn:sequenceFlow id="Flow_PubChemRequest" name="/api/pubchem" sourceRef="Gateway_RequestType" targetRef="Task_PubChemHandler"/>
    <bpmn:sequenceFlow id="Flow_AuthProcessed" sourceRef="Task_AuthHandler" targetRef="Task_DatabaseQuery"/>
    <bpmn:sequenceFlow id="Flow_UserProcessed" sourceRef="Task_UserHandler" targetRef="Task_DatabaseQuery"/>
    <bpmn:sequenceFlow id="Flow_PubChemProcessed" sourceRef="Task_PubChemHandler" targetRef="Task_SendResponse"/>
    <bpmn:sequenceFlow id="Flow_DatabaseDone" sourceRef="Task_DatabaseQuery" targetRef="Task_SendResponse"/>
    <bpmn:sequenceFlow id="Flow_ResponseSent" sourceRef="Task_SendResponse" targetRef="Event_SystemEnd"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <di:BPMNShape id="Participant_Student_di" bpmnElement="Participant_Student" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="600" height="350"/>
      </di:BPMNShape>
      <di:BPMNShape id="Participant_System_di" bpmnElement="Participant_System" isHorizontal="true">
        <dc:Bounds x="100" y="400" width="900" height="400"/>
      </di:BPMNShape>
      <di:BPMNShape id="Event_StudentStart_di" bpmnElement="Event_StudentStart">
        <dc:Bounds x="150" y="90" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="125" y="130" width="86" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_StudentLogin_di" bpmnElement="Task_StudentLogin">
        <dc:Bounds x="230" y="70" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="250" y="105" width="60" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_StudentTakeTraining_di" bpmnElement="Task_StudentTakeTraining">
        <dc:Bounds x="370" y="70" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="375" y="105" width="90" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_StudentDoQuiz_di" bpmnElement="Task_StudentDoQuiz">
        <dc:Bounds x="510" y="70" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="520" y="105" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Gateway_StudentPass_di" bpmnElement="Gateway_StudentPass" isMarkerVisible="true">
        <dc:Bounds x="660" y="90" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="655" y="147" width="60" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Event_StudentPassEnd_di" bpmnElement="Event_StudentPassEnd">
        <dc:Bounds x="562" y="200" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="240" width="84" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_StudentRetrain_di" bpmnElement="Task_StudentRetrain">
        <dc:Bounds x="640" y="200" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="235" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNEdge id="Flow_StudentLogin_di" bpmnElement="Flow_StudentLogin">
        <di:waypoint x="186" y="108"/>
        <di:waypoint x="230" y="108"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_StudentLoginDone_di" bpmnElement="Flow_StudentLoginDone">
        <di:waypoint x="330" y="110"/>
        <di:waypoint x="370" y="110"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_StudentTrainingDone_di" bpmnElement="Flow_StudentTrainingDone">
        <di:waypoint x="470" y="110"/>
        <di:waypoint x="510" y="110"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_StudentQuizDone_di" bpmnElement="Flow_StudentQuizDone">
        <di:waypoint x="610" y="110"/>
        <di:waypoint x="660" y="115"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_StudentPassed_di" bpmnElement="Flow_StudentPassed">
        <di:waypoint x="662" y="140"/>
        <di:waypoint x="580" y="200"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="601" y="162" width="54" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_StudentFailed_di" bpmnElement="Flow_StudentFailed">
        <di:waypoint x="685" y="140"/>
        <di:waypoint x="690" y="200"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="695" y="162" width="52" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_RetrainingLoop_di" bpmnElement="Flow_RetrainingLoop">
        <di:waypoint x="690" y="200"/>
        <di:waypoint x="420" y="150"/>
      </di:BPMNEdge>
      <di:BPMNShape id="Event_SystemStart_di" bpmnElement="Event_SystemStart">
        <dc:Bounds x="150" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="510" width="66" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_SystemListen_di" bpmnElement="Task_SystemListen">
        <dc:Bounds x="230" y="450" width="140" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="240" y="480" width="120" height="28"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Gateway_RequestType_di" bpmnElement="Gateway_RequestType" isMarkerVisible="true">
        <dc:Bounds x="420" y="470" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="440" width="70" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_AuthHandler_di" bpmnElement="Task_AuthHandler">
        <dc:Bounds x="520" y="420" width="120" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="450" width="100" height="28"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_UserHandler_di" bpmnElement="Task_UserHandler">
        <dc:Bounds x="520" y="520" width="120" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="535" y="550" width="90" height="28"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_PubChemHandler_di" bpmnElement="Task_PubChemHandler">
        <dc:Bounds x="520" y="630" width="120" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="660" width="100" height="28"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_DatabaseQuery_di" bpmnElement="Task_DatabaseQuery">
        <dc:Bounds x="700" y="480" width="140" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="710" y="510" width="120" height="28"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_SendResponse_di" bpmnElement="Task_SendResponse">
        <dc:Bounds x="900" y="500" width="130" height="80"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="910" y="530" width="110" height="28"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Event_SystemEnd_di" bpmnElement="Event_SystemEnd">
        <dc:Bounds x="1080" y="522" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1060" y="562" width="76" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNEdge id="Flow_SystemInit_di" bpmnElement="Flow_SystemInit">
        <di:waypoint x="186" y="488"/>
        <di:waypoint x="230" y="490"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_RequestReceived_di" bpmnElement="Flow_RequestReceived">
        <di:waypoint x="370" y="490"/>
        <di:waypoint x="420" y="495"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_AuthRequest_di" bpmnElement="Flow_AuthRequest">
        <di:waypoint x="445" y="470"/>
        <di:waypoint x="520" y="460"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="470" y="455" width="25" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_UserRequest_di" bpmnElement="Flow_UserRequest">
        <di:waypoint x="445" y="495"/>
        <di:waypoint x="520" y="560"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="510" width="50" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_PubChemRequest_di" bpmnElement="Flow_PubChemRequest">
        <di:waypoint x="445" y="520"/>
        <di:waypoint x="520" y="670"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="585" width="60" height="14"/>
        </bpmndi:BPMNLabel>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_AuthProcessed_di" bpmnElement="Flow_AuthProcessed">
        <di:waypoint x="640" y="460"/>
        <di:waypoint x="700" y="510"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_UserProcessed_di" bpmnElement="Flow_UserProcessed">
        <di:waypoint x="640" y="560"/>
        <di:waypoint x="700" y="530"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_PubChemProcessed_di" bpmnElement="Flow_PubChemProcessed">
        <di:waypoint x="640" y="670"/>
        <di:waypoint x="965" y="580"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_DatabaseDone_di" bpmnElement="Flow_DatabaseDone">
        <di:waypoint x="840" y="520"/>
        <di:waypoint x="900" y="540"/>
      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_ResponseSent_di" bpmnElement="Flow_ResponseSent">
        <di:waypoint x="1030" y="540"/>
        <di:waypoint x="1080" y="540"/>
      </di:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>